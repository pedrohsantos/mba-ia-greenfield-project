      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "formatName": {
            "type": "string",
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "bitRate": {
            "type": "number",
            "nullable": true,
            "example": 1500000
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "videoCodec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "audioCodec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "frameRate": {
            "type": "number",
            "nullable": true,
            "example": 29.97
          }
        },
        "required": [
          "formatName",
          "bitRate",
          "width",
          "height",
          "videoCodec",
          "audioCodec",
          "frameRate"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "description": "Unique URL identifier (11 chars, base64url)",
            "example": "dQw4w9WgXcQ"
          },
          "title": {
            "type": "string",
            "example": "aula-1"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoStatus"
              }
            ]
          },
          "originalFilename": {
            "type": "string",
            "example": "aula-1.mp4"
          },
          "contentType": {
            "type": "string",
            "example": "video/mp4"
          },
          "sizeBytes": {
            "type": "number",
            "example": 134217728
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true,
            "example": 125.375
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "description": "Short-lived presigned URL of the generated thumbnail"
          },
          "failureReason": {
            "type": "string",
            "nullable": true,
            "example": "UPLOAD_ABORTED"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "originalFilename",
          "contentType",
          "sizeBytes",
          "durationSeconds",
          "metadata",
          "thumbnailUrl",
          "failureReason",
          "createdAt",
          "updatedAt"
        ]
      },
      "PresignedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned UploadPart URL — PUT the part bytes here"
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoResponseDto"
          },
          "uploadId": {
            "type": "string",
            "description": "Multipart upload id"
          },
          "partSize": {
            "type": "number",
            "example": 67108864
          },
          "partCount": {
            "type": "number",
            "example": 3
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignedPartDto"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "video",
          "uploadId",
          "partSize",
          "partCount",
          "parts",
          "expiresAt"
        ]
      },
      "SignPartsDto": {
        "type": "object",
        "properties": {}
      },
      "SignedPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignedPartDto"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "parts",
          "expiresAt"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "etag": {
            "type": "string",
            "example": "\"5d41402abc4b2a76b9719d911017c592\""
          },
          "size": {
            "type": "number",
            "example": 67108864
          }
        },
        "required": [
          "partNumber",
          "etag",
          "size"
        ]
      },
      "UploadStatusResponseDto": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string"
          },
          "partSize": {
            "type": "number",
            "example": 67108864
          },
          "partCount": {
            "type": "number",
            "example": 3
          },
          "uploadedParts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "uploadId",
          "partSize",
          "partCount",
          "uploadedParts"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "StreamUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Short-lived presigned GET URL; storage answers Range requests with 206 Partial Content"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "url",
          "expiresAt"
        ]
      },
      "DownloadUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Short-lived presigned GET URL served with Content-Disposition: attachment"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "fileName": {
            "type": "string",
            "example": "aula-1.mp4"
          }
        },
        "required": [
          "url",
          "expiresAt",
          "fileName"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}